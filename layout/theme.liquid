<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta name="google-site-verification" content="_pBYo9pDPJAIDUFTygNWLaV1KHKUn2drHnByStAKsOM">
    <link rel="icon" type="image/png" sizes="192x192" href="{{ 'elysian-favicon-192.png' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'elysian-favicon-192.png' | asset_url }}">
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type | handle }}{% if request.design_mode %} shopify-design-mode{% endif %}">
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}
    {% section 'elysian-drop-popup' %}

    {% render 'elysian-reveal' %}
  </body>
</html>
