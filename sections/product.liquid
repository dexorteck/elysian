{% assign current_variant = product.selected_or_first_available_variant %}

<section class="elysian-product">
  <div class="elysian-product__gallery">
    {% for media in product.media %}
      <div class="elysian-product__media">
        {% case media.media_type %}
          {% when 'image' %}
            {{ media | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480, 760, 1100, 1600', alt: media.alt | default: product.title }}
          {% when 'video' %}
            {{ media | video_tag: controls: true, image_size: '1200x' }}
          {% when 'external_video' %}
            {{ media | external_video_tag }}
          {% else %}
            {{ media | media_tag }}
        {% endcase %}
      </div>
    {% endfor %}
  </div>

  <div class="elysian-product__details">
    <p class="elysian-product__eyebrow">{{ product.vendor | default: product.type }}</p>
    <h1 class="elysian-display">{{ product.title }}</h1>
    <div class="elysian-product__price">
      <span>{{ current_variant.price | money }}</span>
      {% if current_variant.compare_at_price > current_variant.price %}
        <s>{{ current_variant.compare_at_price | money }}</s>
      {% endif %}
    </div>

    {% form 'product', product, class: 'elysian-product__form' %}
      {{ form.errors | default_errors }}

      {% unless product.has_only_default_variant %}
        <label for="ProductVariant-{{ section.id }}">{{ 'products.product.options' | t }}</label>
        <select id="ProductVariant-{{ section.id }}" name="id">
          {% for variant in product.variants %}
            <option value="{{ variant.id }}"{% if variant == current_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>
              {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}
            </option>
          {% endfor %}
        </select>
      {% else %}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
      {% endunless %}

      <label for="ProductQuantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
      <input id="ProductQuantity-{{ section.id }}" type="number" name="quantity" min="1" value="1" inputmode="numeric">

      <button class="elysian-product__add" type="submit"{% unless current_variant.available %} disabled{% endunless %}>
        {% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}
      </button>

      {% if current_variant.available %}{{ form | payment_button }}{% endif %}
    {% endform %}

    {% if cart.taxes_included %}<p class="elysian-product__tax">{{ 'products.product.taxes_included' | t }}</p>{% endif %}
    <div class="elysian-product__description">{{ product.description }}</div>
  </div>
</section>

{% stylesheet %}
  .elysian-product {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(20rem, 0.75fr);
    gap: clamp(3rem, 7vw, 8rem);
    padding: clamp(4rem, 8vw, 8rem) 0;
  }

  .elysian-product__gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .elysian-product__media {
    overflow: hidden;
    background: var(--color-surface);
  }

  .elysian-product__media:first-child {
    grid-column: 1 / -1;
  }

  .elysian-product__media img,
  .elysian-product__media video,
  .elysian-product__media iframe {
    width: 100%;
    height: 100%;
    min-height: 22rem;
    object-fit: cover;
  }

  .elysian-product__details {
    position: sticky;
    top: 2rem;
    align-self: start;
  }

  .elysian-product__eyebrow,
  .elysian-product__form label {
    display: block;
    font-size: 0.65rem;
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .elysian-product h1 {
    margin: 2rem 0;
    font-size: clamp(3.6rem, 7vw, 7rem);
  }

  .elysian-product__price {
    display: flex;
    gap: 1rem;
    margin-bottom: 2.5rem;
    font-size: 1rem;
  }

  .elysian-product__price s {
    color: color-mix(in srgb, var(--color-foreground) 45%, transparent);
  }

  .elysian-product__form {
    display: grid;
    gap: 0.75rem;
  }

  .elysian-product__form select,
  .elysian-product__form input[type='number'] {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.8rem 1rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 28%, transparent);
    background: transparent;
    color: inherit;
  }

  .elysian-product__form input[type='number'] {
    width: 7rem;
    margin-bottom: 0.75rem;
  }

  .elysian-product__add {
    min-height: 3.8rem;
    padding: 1rem;
    border: 0;
    background: var(--color-accent);
    color: var(--color-background);
    font-weight: 700;
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
    cursor: pointer;
    transition: background 220ms ease, transform 220ms ease;
  }

  .elysian-product__add:hover:not(:disabled) {
    background: var(--color-foreground);
  }

  .elysian-product__add:active:not(:disabled) {
    transform: translateY(1px);
  }

  .elysian-product__add:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .elysian-product__tax {
    margin-top: 1rem;
    color: color-mix(in srgb, var(--color-foreground) 50%, transparent);
    font-size: 0.72rem;
  }

  .elysian-product__description {
    margin-top: 3rem;
    color: color-mix(in srgb, var(--color-foreground) 72%, transparent);
    line-height: 1.65;
  }

  .elysian-product__description > * + * {
    margin-top: 1rem;
  }

  @media (max-width: 800px) {
    .elysian-product {
      grid-template-columns: 1fr;
      padding: 3rem 0 5rem;
    }

    .elysian-product__details {
      position: static;
    }

    .elysian-product__gallery {
      grid-template-columns: 1fr;
    }

    .elysian-product__media:first-child {
      grid-column: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
