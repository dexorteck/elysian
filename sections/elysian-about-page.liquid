{% liquid
  assign about_heading = section.settings.heading
  if about_heading == blank
    assign about_heading = page.title
  endif
%}

<section class="elysian-about-page full-width">
  <div class="elysian-about-page__story">
    <div class="elysian-about-page__copy elysian-reveal">
      <div class="elysian-about-page__body" data-about-story data-about-images="{{ 'gallery-1year-8.jpg' | asset_url }},{{ 'gallery-faq-loft.jpg' | asset_url }},{{ 'gallery-1year-21.jpg' | asset_url }},{{ 'gallery-loft-2.jpg' | asset_url }},{{ 'gallery-1year-27.jpg' | asset_url }},{{ 'gallery-1year-12.jpg' | asset_url }},{{ 'gallery-loft-4.jpg' | asset_url }},{{ 'gallery-1year-23.jpg' | asset_url }},{{ 'gallery-loft-7.jpg' | asset_url }},{{ 'gallery-1year-29.jpg' | asset_url }}">
        {% if page.content != blank %}
          {{ page.content }}
        {% else %}
          {{ section.settings.body }}
        {% endif %}
      </div>

      {% if section.settings.link_label != blank %}
        <a href="{{ section.settings.link | default: routes.root_url }}">
          {{ section.settings.link_label }}
          <svg aria-hidden="true" viewBox="0 0 18 18"><path d="M3 15 15 3M7 3h8v8" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
        </a>
      {% endif %}
    </div>
  </div>

</section>

{% stylesheet %}
  .elysian-about-page {
    padding: clamp(1.75rem, 3.5vw, 3.5rem) var(--site-edge);
    background: #090909;
    color: #f0eadf;
  }

  .elysian-about-page__header {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
    padding-bottom: clamp(3rem, 5vw, 5rem);
  }

  .elysian-about-page__header > p {
    grid-column: 1 / span 2;
    padding-top: 0.65rem;
    color: var(--color-accent);
    font-size: 0.65rem;
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .elysian-about-page__header h1 {
    grid-column: 4 / -1;
    max-width: 18ch;
    font-size: clamp(2.2rem, 4vw, 4rem);
    line-height: 0.95;
  }

  .elysian-about-page__story {
    display: block;
  }

  .elysian-about-page__media {
    position: relative;
    grid-column: 1 / span 7;
    min-height: 32rem;
    overflow: hidden;
  }

  .elysian-about-page__media img {
    width: 100%;
    height: 100%;
    min-height: 32rem;
    object-fit: cover;
  }

  .elysian-about-page__media > span {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    display: grid;
    width: 6.5rem;
    height: 6.5rem;
    place-items: center;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-background);
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1.25;
    text-align: center;
    text-transform: uppercase;
    transform: rotate(7deg);
  }

  .elysian-about-page__copy {
    width: 100%;
    max-width: none;
    padding-bottom: 1rem;
  }

  .elysian-about-page__statement {
    margin-bottom: 2.5rem;
    font-family: var(--font-display-family);
    font-style: var(--font-display-style);
    font-size: clamp(1.5rem, 2.4vw, 2.5rem);
    font-weight: var(--font-display-weight);
    letter-spacing: var(--letter-spacing-display);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .elysian-about-page__body {
    color: color-mix(in srgb, #f0eadf 76%, transparent);
    font-size: clamp(0.9rem, 1.1vw, 1.05rem);
    line-height: 1.55;
  }

  .elysian-about-page__body > * + * {
    margin-top: 1.25rem;
  }

  .elysian-about-page__body h3 {
    margin-top: 4rem;
    padding-top: 0.8rem;
    border-top: 1px solid color-mix(in srgb, #f0eadf 28%, transparent);
    color: #f20000;
    font-size: clamp(1.4rem, 2.8vw, 2.8rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .elysian-about-page__body h3 + p {
    margin-top: 1rem;
  }

  .elysian-about-page__body > h3:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .elysian-about-page__chapter:first-child h3 {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .elysian-about-page__body p {
    max-width: 48rem;
  }

  .elysian-about-page__chapter {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.72fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: start;
    margin-top: 5rem;
  }

  .elysian-about-page__chapter:first-child { margin-top: 0; }

  .elysian-about-page__chapter > h3 {
    grid-column: 1 / -1;
    margin: 0;
  }

  .elysian-about-page__chapter-copy { grid-column: 1; }

  .elysian-about-page__chapter-image {
    grid-column: 2;
    grid-row: 2;
    width: 100%;
    height: clamp(16rem, 28vw, 28rem);
    object-fit: cover;
  }

  .elysian-about-page__chapter:nth-child(even) {
    grid-template-columns: minmax(12rem, 0.72fr) minmax(0, 1fr);
  }

  .elysian-about-page__chapter:nth-child(even) .elysian-about-page__chapter-copy { grid-column: 2; }
  .elysian-about-page__chapter:nth-child(even) .elysian-about-page__chapter-image { grid-column: 1; }

  .elysian-about-page__copy > a {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 3rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid currentcolor;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: var(--letter-spacing-label);
    text-decoration: none;
    text-transform: uppercase;
  }

  .elysian-about-page__copy svg {
    width: 1rem;
    color: var(--color-accent);
    transition: transform 220ms ease;
  }

  .elysian-about-page__copy > a:hover svg {
    transform: translate3d(0.2rem, -0.2rem, 0);
  }

  .elysian-about-page__closing {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
    align-items: end;
    margin-top: clamp(5rem, 9vw, 9rem);
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
  }

  .elysian-about-page__gallery {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr 1.15fr;
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
    margin-top: clamp(4rem, 7vw, 7rem);
  }

  .elysian-about-page__gallery img {
    width: 100%;
    height: clamp(14rem, 24vw, 24rem);
    object-fit: cover;
  }

  .elysian-about-page__gallery img:nth-child(2) {
    margin-top: clamp(2rem, 6vw, 6rem);
  }

  .elysian-about-page__closing > p:first-child {
    grid-column: 1 / span 3;
    font-size: 0.65rem;
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .elysian-about-page__closing > p:last-child {
    grid-column: 5 / -1;
    font-size: clamp(2rem, 4vw, 4rem);
  }

  @media (max-width: 800px) {
    .elysian-about-page {
      padding-top: 6rem;
    }

    .elysian-about-page__header,
    .elysian-about-page__story,
    .elysian-about-page__gallery,
    .elysian-about-page__closing {
      display: block;
    }

    .elysian-about-page__header h1 {
      margin-top: 2rem;
      font-size: 8vw;
    }

    .elysian-about-page__media,
    .elysian-about-page__media img {
      min-height: 25rem;
    }

    .elysian-about-page__copy {
      padding-top: 3.5rem;
    }

    .elysian-about-page__gallery {
      margin-top: 4.5rem;
    }

    .elysian-about-page__gallery img {
      height: 28rem;
      margin-top: 1rem;
    }

    .elysian-about-page__gallery img:first-child { margin-top: 0; }


    .elysian-about-page__chapter,
    .elysian-about-page__chapter:nth-child(even) {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      margin-top: 4rem;
    }

    .elysian-about-page__chapter-image,
    .elysian-about-page__chapter:nth-child(even) .elysian-about-page__chapter-image {
      order: 2;
      width: 100%;
      height: 22rem;
      grid-column: auto;
      grid-row: auto;
    }

    .elysian-about-page__closing > p:last-child {
      margin-top: 3rem;
      font-size: 8vw;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-about-story]').forEach((body) => {
    const images = (body.dataset.aboutImages || '').split(',');
    const headings = Array.from(body.querySelectorAll('h3'));
    headings.forEach((heading, index) => {
      const chapter = document.createElement('div');
      chapter.className = 'elysian-about-page__chapter';
      const copy = document.createElement('div');
      copy.className = 'elysian-about-page__chapter-copy';
      body.insertBefore(chapter, heading);
      let node = heading;
      while (node && (node === heading || node.tagName !== 'H3')) {
        const next = node.nextElementSibling;
        copy.appendChild(node);
        node = next;
      }
      chapter.appendChild(copy);
      const source = images[index];
      if (source) {
        const image = document.createElement('img');
        image.className = 'elysian-about-page__chapter-image';
        image.src = source;
        image.alt = 'Elysian Groove';
        image.loading = 'lazy';
        chapter.appendChild(image);
      }
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "Elysian about page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "About Elysian" },
    { "type": "textarea", "id": "heading", "label": "t:labels.heading", "default": "More than\na party." },
    { "type": "image_picker", "id": "image", "label": "t:labels.image" },
    { "type": "text", "id": "image_alt", "label": "t:labels.image_alt", "default": "The Elysian community dancing together" },
    { "type": "textarea", "id": "stamp", "label": "t:labels.stamp", "default": "EST. 2023\nLISBON" },
    { "type": "textarea", "id": "statement", "label": "Statement", "default": "We don't throw parties. We create memories." },
    { "type": "richtext", "id": "body", "label": "t:labels.body", "default": "<p>Born under Lisbon's golden skies, Elysian is a community built around music, movement and the moments you wish would never end.</p><p>From first light to last track — come as you are, leave as part of something.</p>" },
    { "type": "text", "id": "link_label", "label": "t:labels.link_label", "default": "Follow the journey" },
    { "type": "url", "id": "link", "label": "t:labels.link" },
    { "type": "text", "id": "closing_eyebrow", "label": "Closing label", "default": "Our philosophy" },
    { "type": "textarea", "id": "closing_text", "label": "Closing text", "default": "Come as you are.\nLeave as one of us." }
  ],
  "presets": [{ "name": "Elysian about page" }]
}
{% endschema %}
