{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}

<section class="elysian-collection full-width">
  <header class="elysian-collection__header">
    <form class="elysian-collection__sort" action="{{ collection.url }}" method="get">
      <label for="SortBy-{{ section.id }}">{{ 'collections.sorting.label' | t }}</label>
      <select id="SortBy-{{ section.id }}" name="sort_by" data-collection-sort>
        {% for option in collection.sort_options %}
          <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
        {% endfor %}
      </select>
    </form>
    {% if collection.all_types.size > 0 %}
      <nav class="elysian-collection__categories" aria-label="{{ 'products.product.options' | t }}">
        {% for product_type in collection.all_types %}
          {% if product_type != blank %}{{ product_type | link_to_type }}{% endif %}
        {% endfor %}
      </nav>
    {% endif %}
  </header>

  {% paginate collection.products by 20 %}
    <div class="elysian-collection__grid">
      {% for product in collection.products %}
        {% assign minimum_price = product.price_min | money %}
        <article class="elysian-product-card">
          <a class="elysian-product-card__image" href="{{ product.url }}">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 680, 900', alt: product.featured_image.alt | default: product.title }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag }}
            {% endif %}
            {% if product.compare_at_price_max > product.price %}<span>{{ 'products.product.sale' | t }}</span>{% endif %}
          </a>
          <div class="elysian-product-card__content">
            <h2><a href="{{ product.url }}">{{ product.title }}</a></h2>
            <p>{% if product.price_varies %}{{ 'products.product.from_price_html' | t: price: minimum_price }}{% else %}{{ product.price | money }}{% endif %}</p>
          </div>
        </article>
      {% else %}
        <p class="elysian-collection__empty">{{ 'collections.collection.empty' | t }}</p>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}<div class="elysian-pagination">{{ paginate | default_pagination }}</div>{% endif %}
  {% endpaginate %}
</section>

{% stylesheet %}
  .elysian-collection {
    padding: 1rem 0 clamp(3rem, 6vw, 6rem);
  }

  .elysian-collection__header {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.75rem 1rem;
    padding: 0 var(--site-edge) 1rem;
  }

  .elysian-collection__header > div > p,
  .elysian-collection__sort label {
    display: block;
    font-size: 0.65rem;
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .elysian-collection h1 {
    margin: 0;
    font-family: var(--font-primary-family);
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1.25;
  }

  .elysian-collection h1 sup { font-size: 0.65rem; vertical-align: super; }
  .elysian-collection__categories { grid-column: 1 / -1; display: flex; gap: 1.25rem; overflow-x: auto; font-size: 0.75rem; white-space: nowrap; }
  .elysian-collection__categories a { color: inherit; text-decoration: none; padding: 0.5rem 0; }
  .elysian-collection__categories a:hover { text-decoration: underline; }
  .elysian-collection__sort { grid-column: 2; display: flex; align-items: center; gap: 0.6rem; }

  .elysian-collection__header .rte {
    max-width: 42rem;
    color: color-mix(in srgb, var(--color-foreground) 65%, transparent);
    line-height: 1.6;
  }

  .elysian-collection__sort select {
    min-width: 0;
    max-width: 12rem;
    margin: 0;
    padding: 0.6rem 0;
    border: 0;
    background: var(--color-background);
    color: inherit;
    font-size: 0.75rem;
  }

  .elysian-collection__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem 1px;
  }

  .elysian-product-card__image {
    position: relative;
    display: block;
    overflow: hidden;
    width: 100%;
    height: clamp(20rem, 58svh, 34rem);
    background: var(--color-surface);
  }

  .elysian-product-card__image img,
  .elysian-product-card__image svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 650ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .elysian-product-card:hover .elysian-product-card__image img {
    transform: scale(1.035);
  }

  .elysian-product-card__image span {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.45rem 0.65rem;
    background: var(--color-accent);
    color: var(--color-background);
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .elysian-product-card__content {
    display: block;
    width: 100%;
    padding: 0.65rem 0 0.65rem clamp(0.25rem, 0.5vw, 0.5rem);
  }

  .elysian-product-card__content h2 {
    font-family: var(--font-primary-family);
    font-style: normal;
    font-weight: 400;
    font-size: 0.75rem;
    letter-spacing: normal;
    line-height: 1.35;
    margin: 0;
    text-transform: none;
  }

  .elysian-product-card__content a {
    text-decoration: none;
  }

  .elysian-product-card__content p {
    margin: 0.2rem 0 0;
    font-size: 0.78rem;
  }

  .elysian-pagination {
    margin-top: 4rem;
    text-align: center;
  }

  .elysian-pagination a,
  .elysian-pagination span {
    display: inline-block;
    padding: 0.5rem;
    color: inherit;
  }

  .elysian-collection__empty {
    grid-column: 1 / -1;
    padding: 4rem 0;
    border-block: 1px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
  }

  @media (max-width: 800px) {
    .elysian-collection__header {
      grid-template-columns: 1fr auto;
    }

    .elysian-collection__sort {
      margin-top: 0;
    }

    .elysian-collection__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .elysian-collection__sort label { display: none; }
    .elysian-collection__sort select { max-width: 10rem; }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-collection-sort]').forEach((select) => {
    select.addEventListener('change', () => select.form.submit());
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
