{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}

<section class="elysian-collection">
  <header class="elysian-collection__header">
    <form class="elysian-collection__sort" action="{{ collection.url }}" method="get">
      <label for="SortBy-{{ section.id }}">{{ 'collections.sorting.label' | t }}</label>
      <select id="SortBy-{{ section.id }}" name="sort_by" data-collection-sort>
        {% for option in collection.sort_options %}
          <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
        {% endfor %}
      </select>
    </form>
  </header>

  {% paginate collection.products by 20 %}
    <div class="elysian-collection__grid">
      {% for product in collection.products %}
        {% assign minimum_price = product.price_min | money %}
        <article class="elysian-product-card">
          <a class="elysian-product-card__image" href="{{ product.url }}">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 680, 900', alt: product.featured_image.alt | default: product.title }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag }}
            {% endif %}
            {% if product.compare_at_price_max > product.price %}<span>{{ 'products.product.sale' | t }}</span>{% endif %}
          </a>
          <div class="elysian-product-card__content">
            <h2><a href="{{ product.url }}">{{ product.title }}</a></h2>
            <p>{% if product.price_varies %}{{ 'products.product.from_price_html' | t: price: minimum_price }}{% else %}{{ product.price | money }}{% endif %}</p>
          </div>
        </article>
      {% else %}
        <p class="elysian-collection__empty">{{ 'collections.collection.empty' | t }}</p>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}<div class="elysian-pagination">{{ paginate | default_pagination }}</div>{% endif %}
  {% endpaginate %}
</section>

{% stylesheet %}
  .elysian-collection {
    padding: clamp(3rem, 5vw, 5rem) 0 clamp(5rem, 9vw, 9rem);
  }

  .elysian-collection__header {
    display: flex;
    align-items: end;
    justify-content: flex-end;
    gap: 3rem;
    margin-bottom: clamp(1.5rem, 3vw, 3rem);
  }

  .elysian-collection__header > div > p,
  .elysian-collection__sort label {
    display: block;
    font-size: 0.65rem;
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .elysian-collection h1 {
    margin: 1.25rem 0;
    font-size: clamp(3rem, 6vw, 6rem);
  }

  .elysian-collection__header .rte {
    max-width: 42rem;
    color: color-mix(in srgb, var(--color-foreground) 65%, transparent);
    line-height: 1.6;
  }

  .elysian-collection__sort select {
    min-width: 13rem;
    margin-top: 0.75rem;
    padding: 0.8rem 2.5rem 0.8rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 28%, transparent);
  }

  .elysian-collection__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 3rem) 1rem;
  }

  .elysian-product-card__image {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: var(--color-surface);
  }

  .elysian-product-card__image img,
  .elysian-product-card__image svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 650ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .elysian-product-card:hover .elysian-product-card__image img {
    transform: scale(1.035);
  }

  .elysian-product-card__image span {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.45rem 0.65rem;
    background: var(--color-accent);
    color: var(--color-background);
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .elysian-product-card__content {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
  }

  .elysian-product-card__content h2 {
    font-family: var(--font-display-family);
    font-style: var(--font-display-style);
    font-weight: var(--font-display-weight);
    font-size: 1rem;
    letter-spacing: var(--letter-spacing-display);
    text-transform: uppercase;
  }

  .elysian-product-card__content a {
    text-decoration: none;
  }

  .elysian-product-card__content p {
    flex-shrink: 0;
    font-size: 0.78rem;
  }

  .elysian-pagination {
    margin-top: 4rem;
    text-align: center;
  }

  .elysian-pagination a,
  .elysian-pagination span {
    display: inline-block;
    padding: 0.5rem;
    color: inherit;
  }

  .elysian-collection__empty {
    grid-column: 1 / -1;
    padding: 4rem 0;
    border-block: 1px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
  }

  @media (max-width: 800px) {
    .elysian-collection__header {
      display: block;
    }

    .elysian-collection__sort {
      margin-top: 2rem;
    }

    .elysian-collection__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .elysian-collection__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-collection-sort]').forEach((select) => {
    select.addEventListener('change', () => select.form.submit());
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
