<section
  class="elysian-shop full-width"
  id="shop"
  style="--shop-background: {{ section.settings.background }}; --shop-foreground: {{ section.settings.foreground }};"
>
  <header class="elysian-shop__bar elysian-reveal">
    <h2>{{ section.settings.eyebrow }}</h2>
    <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
      {{ section.settings.button_label }}
    </a>
  </header>

  <div class="elysian-shop__grid">
    {% for card_product in collections.all.products limit: 4 %}
      {% assign card_alt = card_product.featured_image.alt | default: card_product.title %}
      {% assign card_loading = 'lazy' %}
      {% if forloop.first %}{% assign card_loading = 'eager' %}{% endif %}
      <article class="elysian-shop-card elysian-reveal" style="--card-index: {{ forloop.index0 }}">
        <a class="elysian-shop-card__image" href="{{ card_product.url }}">
          {% if card_product.featured_image %}
            {{ card_product.featured_image | image_url: width: 900 | image_tag: loading: card_loading, widths: '320, 480, 680, 900', sizes: '(min-width: 901px) 25vw, 50vw', alt: card_alt }}
          {% else %}
            {{ 'product-1' | placeholder_svg_tag }}
          {% endif %}
          {% unless card_product.available %}<span class="elysian-shop-card__badge">{{ 'products.product.sold_out' | t }}</span>{% endunless %}
        </a>
        <div class="elysian-shop-card__meta">
          <h3><a href="{{ card_product.url }}">{{ card_product.title }}</a></h3>
          <p>{% if card_product.price_varies %}{{ 'products.product.from_price_html' | t: price: card_product.price_min | money }}{% else %}{{ card_product.price | money }}{% endif %}</p>
        </div>
      </article>
    {% else %}
      <p class="elysian-shop__empty">{{ 'collections.collection.empty' | t }}</p>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .elysian-shop {
    margin-top: -1px;
    padding: clamp(2rem, 3.5vw, 3.5rem) var(--site-edge) clamp(4rem, 6vw, 6rem);
    background: var(--shop-background);
    color: var(--shop-foreground);
  }

  .elysian-shop__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(1.75rem, 3.5vw, 3.25rem);
  }

  .elysian-shop__bar h2,
  .elysian-shop__bar a {
    font-family: var(--font-body-family);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .elysian-shop__bar a {
    color: inherit;
    text-decoration: none;
  }

  .elysian-shop__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem 1px;
  }

  .elysian-shop-card {
    transition-delay: calc(var(--card-index) * 80ms);
  }

  .elysian-shop-card__image {
    position: relative;
    display: block;
    overflow: hidden;
    width: 100%;
    height: clamp(20rem, 58svh, 34rem);
    background: var(--shop-background);
  }

  .elysian-shop-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .elysian-shop-card:hover .elysian-shop-card__image img {
    transform: scale(1.025);
  }

  .elysian-shop-card__badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.5rem 0.7rem;
    background: var(--shop-background);
    color: var(--shop-foreground);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .elysian-shop-card__meta {
    display: block;
    width: 100%;
    padding: 0.65rem 0 0.65rem clamp(0.25rem, 0.5vw, 0.5rem);
  }

  .elysian-shop-card__meta h3 {
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: normal;
    line-height: 1.35;
    margin: 0;
  }

  .elysian-shop-card__meta a {
    text-decoration: none;
  }

  .elysian-shop-card__meta p {
    margin: 0.2rem 0 0;
    font-size: 0.78rem;
  }

  .elysian-shop__empty {
    grid-column: 1 / -1;
    padding: 4rem 0;
    border-block: 1px solid color-mix(in srgb, var(--shop-foreground) 18%, transparent);
  }

  @media (max-width: 900px) {
    .elysian-shop__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 0.75rem;
    }
  }

  @media (max-width: 520px) {
    .elysian-shop__bar {
      margin-bottom: 1.75rem;
    }

    .elysian-shop__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.elysian_shop.name",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "New arrivals" },
    { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "Shop all" },
    { "type": "url", "id": "button_link", "label": "t:labels.button_link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#090909" },
    { "type": "color", "id": "foreground", "label": "Text", "default": "#f0eadf" }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "t:blocks.product_card.name",
      "settings": [
        { "type": "product", "id": "product", "label": "t:labels.product" },
        { "type": "text", "id": "fallback_title", "label": "t:labels.placeholder_title", "default": "Tee" },
        { "type": "text", "id": "fallback_price", "label": "t:labels.placeholder_price", "default": "€38" },
        {
          "type": "select",
          "id": "placeholder",
          "label": "t:labels.placeholder_image",
          "options": [
            { "value": "pink", "label": "Pink tee" },
            { "value": "yellow", "label": "Yellow tee" },
            { "value": "ringer", "label": "Ringer tee" },
            { "value": "cream", "label": "Cream tee" }
          ],
          "default": "pink"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.elysian_shop.name",
      "blocks": [
        { "type": "product_card", "settings": { "placeholder": "pink", "fallback_title": "Tee 1", "fallback_price": "€50" } },
        { "type": "product_card", "settings": { "placeholder": "yellow", "fallback_title": "Tee 2", "fallback_price": "€50" } },
        { "type": "product_card", "settings": { "placeholder": "ringer", "fallback_title": "Tee 3", "fallback_price": "€50" } },
        { "type": "product_card", "settings": { "placeholder": "cream", "fallback_title": "Tee 4", "fallback_price": "€50" } }
      ]
    }
  ]
}
{% endschema %}
