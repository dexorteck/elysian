<section
  class="elysian-shop full-width"
  id="shop"
  style="--shop-background: {{ section.settings.background }}; --shop-foreground: {{ section.settings.foreground }};"
>
  <header class="elysian-shop__bar elysian-reveal">
    <h2>{{ section.settings.eyebrow }}</h2>
    <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
      {{ section.settings.button_label }}
    </a>
  </header>

  <div class="elysian-shop__grid">
    {% for block in section.blocks %}
      {% liquid
        assign card_product = block.settings.product
        assign card_url = routes.all_products_collection_url
        assign card_title = block.settings.fallback_title
        assign card_price = block.settings.fallback_price
        assign card_alt = block.settings.fallback_title
        case block.settings.placeholder
          when 'yellow'
            assign placeholder_asset = 'tee-2-shop.jpg'
          when 'ringer'
            assign placeholder_asset = 'tee-3-shop.jpg'
          when 'cream'
            assign placeholder_asset = 'tee-4-shop.jpg'
          else
            assign placeholder_asset = 'tee-1-shop.jpg'
        endcase

        if card_product != blank
          assign card_url = card_product.url
          assign card_title = card_product.title
          assign card_price = card_product.price | money
          assign card_alt = card_product.featured_image.alt | default: card_product.title
        endif
      %}

      <article class="elysian-shop-card elysian-reveal" style="--card-index: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
        <a class="elysian-shop-card__image" href="{{ card_url }}">
          {% if card_product.featured_image %}
            {{ card_product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360, 600, 900, 1200', alt: card_alt }}
          {% else %}
            <img src="{{ placeholder_asset | asset_url }}" width="1600" height="2400" loading="lazy" alt="{{ card_alt | escape }}">
          {% endif %}
          {% unless card_product == blank %}
            {% unless card_product.available %}<span class="elysian-shop-card__badge">{{ 'products.product.sold_out' | t }}</span>{% endunless %}
          {% endunless %}
        </a>
        <div class="elysian-shop-card__meta">
          <h3><a href="{{ card_url }}">{{ card_title }}</a></h3>
          <p>{{ card_price }}</p>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .elysian-shop {
    margin-top: -1px;
    padding: clamp(2rem, 3.5vw, 3.5rem) var(--site-edge) clamp(4rem, 6vw, 6rem);
    background: var(--shop-background);
    color: var(--shop-foreground);
  }

  .elysian-shop__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(1.75rem, 3.5vw, 3.25rem);
  }

  .elysian-shop__bar h2,
  .elysian-shop__bar a {
    font-family: var(--font-body-family);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .elysian-shop__bar a {
    color: inherit;
    text-decoration: none;
  }

  .elysian-shop__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 1.6vw, 2rem);
    align-items: start;
  }

  .elysian-shop-card {
    transition-delay: calc(var(--card-index) * 80ms);
  }

  .elysian-shop-card__image {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: color-mix(in srgb, var(--shop-background) 93%, white);
  }

  .elysian-shop-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .elysian-shop-card:hover .elysian-shop-card__image img {
    transform: scale(1.025);
  }

  .elysian-shop-card__badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.5rem 0.7rem;
    background: var(--shop-background);
    color: var(--shop-foreground);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .elysian-shop-card__meta {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    padding-top: 1.15rem;
    text-align: center;
  }

  .elysian-shop-card__meta h3 {
    font-family: var(--font-body-family);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .elysian-shop-card__meta a {
    text-decoration: none;
  }

  .elysian-shop-card__meta p {
    font-size: 0.65rem;
    letter-spacing: 0.02em;
  }

  @media (max-width: 900px) {
    .elysian-shop__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 3.5rem;
    }
  }

  @media (max-width: 520px) {
    .elysian-shop__bar {
      margin-bottom: 1.75rem;
    }

    .elysian-shop__grid {
      gap: 2.75rem 0.6rem;
    }

    .elysian-shop-card__meta {
      padding-top: 0.8rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.elysian_shop.name",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "New arrivals" },
    { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "Shop all" },
    { "type": "url", "id": "button_link", "label": "t:labels.button_link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#090909" },
    { "type": "color", "id": "foreground", "label": "Text", "default": "#f0eadf" }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "t:blocks.product_card.name",
      "settings": [
        { "type": "product", "id": "product", "label": "t:labels.product" },
        { "type": "text", "id": "fallback_title", "label": "t:labels.placeholder_title", "default": "Tee" },
        { "type": "text", "id": "fallback_price", "label": "t:labels.placeholder_price", "default": "€38" },
        {
          "type": "select",
          "id": "placeholder",
          "label": "t:labels.placeholder_image",
          "options": [
            { "value": "pink", "label": "Pink tee" },
            { "value": "yellow", "label": "Yellow tee" },
            { "value": "ringer", "label": "Ringer tee" },
            { "value": "cream", "label": "Cream tee" }
          ],
          "default": "pink"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.elysian_shop.name",
      "blocks": [
        { "type": "product_card", "settings": { "placeholder": "pink", "fallback_title": "Tee 1", "fallback_price": "€50" } },
        { "type": "product_card", "settings": { "placeholder": "yellow", "fallback_title": "Tee 2", "fallback_price": "€50" } },
        { "type": "product_card", "settings": { "placeholder": "ringer", "fallback_title": "Tee 3", "fallback_price": "€50" } },
        { "type": "product_card", "settings": { "placeholder": "cream", "fallback_title": "Tee 4", "fallback_price": "€50" } }
      ]
    }
  ]
}
{% endschema %}
