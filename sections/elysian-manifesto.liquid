<section class="elysian-manifesto full-width elysian-reveal" id="gallery">
  <p>{{ section.settings.top_text }}</p>
  <div class="elysian-manifesto__line">
    <span class="elysian-display">{{ section.settings.left_word }}</span>
    <div class="elysian-manifesto__image">
      {% if section.settings.image %}
        {{ section.settings.image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '240, 480, 720', alt: section.settings.image_alt }}
      {% else %}
        <img src="{{ 'elysian-manifesto.jpg' | asset_url }}" width="1600" height="2400" loading="lazy" alt="{{ section.settings.image_alt | escape }}">
      {% endif %}
    </div>
    <span class="elysian-display">{{ section.settings.right_word }}</span>
  </div>
  <p>{{ section.settings.bottom_text }}</p>
</section>

{% stylesheet %}
  .elysian-manifesto {
    background: var(--color-accent);
    color: #fff;
    overflow: hidden;
    padding: clamp(6rem, 11vw, 11rem) var(--site-edge);
    text-align: center;
  }

  .elysian-manifesto > p {
    font-size: 0.7rem;
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .elysian-manifesto__line {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2vw;
    margin: 1.5rem 0;
    color: #fff;
  }

  .elysian-manifesto__line > span {
    font-size: clamp(7rem, 21vw, 22rem);
  }

  .elysian-manifesto__image {
    width: 13vw;
    min-width: 8rem;
    aspect-ratio: 1.25;
    overflow: hidden;
    transform: rotate(-6deg);
  }

  .elysian-manifesto__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 680px) {
    .elysian-manifesto__line > span {
      font-size: 27vw;
    }

    .elysian-manifesto__image {
      min-width: 5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.elysian_manifesto.name",
  "settings": [
    { "type": "text", "id": "top_text", "label": "t:labels.top_text", "default": "This is your sign to" },
    { "type": "text", "id": "left_word", "label": "t:labels.left_word", "default": "Go" },
    { "type": "image_picker", "id": "image", "label": "t:labels.image" },
    { "type": "text", "id": "image_alt", "label": "t:labels.image_alt", "default": "Friends celebrating together on a boat" },
    { "type": "text", "id": "right_word", "label": "t:labels.right_word", "default": "Out" },
    { "type": "text", "id": "bottom_text", "label": "t:labels.bottom_text", "default": "And lose track of time." }
  ],
  "presets": [{ "name": "t:sections.elysian_manifesto.name" }]
}
{% endschema %}
