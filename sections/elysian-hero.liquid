<section class="elysian-hero full-width" aria-labelledby="ElysianHeroTitle-{{ section.id }}">
  <div class="elysian-hero__media" aria-hidden="true">
    <video autoplay muted loop playsinline preload="auto">
      <source src="{{ 'thank-you-lisboa.mp4' | asset_url }}" type="video/mp4">
    </video>
  </div>
  <div class="elysian-hero__shade" aria-hidden="true"></div>

  <div class="elysian-hero__tag">
    <h1 id="ElysianHeroTitle-{{ section.id }}" class="visually-hidden">{{ section.settings.accessible_heading }}</h1>
    {{ section.settings.tagline | newline_to_br }}
  </div>

  <div class="elysian-hero__event">
    <div>
      <small>{{ section.settings.event_label }}</small>
      <strong class="elysian-display">{{ section.settings.event_name | newline_to_br }}</strong>
    </div>
    <div class="elysian-hero__event-meta">
      <b>{{ section.settings.event_date }}</b>
      <span>{{ section.settings.event_location | newline_to_br }}</span>
    </div>
    {% if section.settings.event_link != blank %}
      <a href="{{ section.settings.event_link }}" aria-label="{{ section.settings.event_name | escape }}">
        <svg aria-hidden="true" viewBox="0 0 28 28"><path d="M6 6h16v16M22 6 6 22" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
      </a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .elysian-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: end;
    gap: clamp(2rem, 5vw, 6rem);
    min-height: clamp(34rem, 82svh, 56rem);
    padding: 8rem var(--site-edge) clamp(3rem, 6vw, 6rem);
    overflow: hidden;
    background: var(--color-surface);
  }

  .elysian-hero__media,
  .elysian-hero__shade {
    position: absolute;
    inset: 0;
  }

  .elysian-hero__media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.86) contrast(1.08);
  }

  .elysian-hero__shade {
    background: linear-gradient(180deg, rgba(8, 8, 8, 0.48), transparent 35%, rgba(8, 8, 8, 0.34) 62%, var(--color-background) 100%), rgba(8, 8, 8, 0.12);
  }

  .elysian-hero__tag {
    position: relative;
    min-width: 0;
    max-width: none;
    font-family: var(--font-display-family);
    font-style: normal;
    font-size: clamp(1.5rem, 3.7vw, 3.75rem);
    font-weight: var(--font-display-weight);
    letter-spacing: var(--letter-spacing-display);
    line-height: 1.08;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .elysian-hero__event {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: end;
    width: 100%;
    padding: 1.25rem 0;
    border-top: 1px solid currentcolor;
  }

  .elysian-hero__event small {
    display: block;
    margin-bottom: 0.7rem;
    color: color-mix(in srgb, var(--color-foreground) 68%, transparent);
    font-size: 0.62rem;
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .elysian-hero__event strong {
    display: block;
    font-style: normal;
    line-height: 1.08;
    font-size: clamp(1.2rem, 2vw, 1.7rem);
  }

  .elysian-hero__event-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .elysian-hero__event-meta span {
    color: color-mix(in srgb, var(--color-foreground) 68%, transparent);
  }

  .elysian-hero__event a {
    align-self: end;
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: var(--color-accent);
    transition: transform 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .elysian-hero__event a:hover {
    transform: translate3d(0.2rem, -0.2rem, 0);
  }

  .elysian-hero__event svg {
    width: 2rem;
  }

  @media (max-width: 1000px) {
    .elysian-hero {
      grid-template-columns: minmax(0, 1fr);
      align-content: end;
      gap: 2.5rem;
      min-height: clamp(34rem, 82svh, 48rem);
    }

    .elysian-hero__tag {
      font-size: clamp(1.5rem, 5.8vw, 3.5rem);
    }

    .elysian-hero__event {
      max-width: 32rem;
      padding-bottom: 0;
    }
  }

  @media (min-width: 1001px) {
    .elysian-hero__tag,
    .elysian-hero__event strong {
      font-family: var(--font-primary-family);
      font-style: normal;
      font-weight: 500;
      letter-spacing: -0.035em;
      line-height: 1;
      text-transform: none;
    }

    .elysian-hero__tag {
      font-size: clamp(2rem, 3.2vw, 3.35rem);
    }

    .elysian-hero__event strong {
      font-size: clamp(1.25rem, 1.8vw, 1.55rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .elysian-hero__media video {
      display: none;
    }

  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.elysian_hero.name",
  "settings": [
    { "type": "video", "id": "video", "label": "t:labels.background_video" },
    { "type": "text", "id": "accessible_heading", "label": "t:labels.accessible_heading", "default": "Elysian — sunset to sunrise" },
    { "type": "textarea", "id": "tagline", "label": "t:labels.tagline", "default": "Chase the sun.\nStay for the night." },
    { "type": "text", "id": "event_label", "label": "t:labels.event_label", "default": "Next event" },
    { "type": "textarea", "id": "event_name", "label": "t:labels.event_name", "default": "Bliss\nVilamoura" },
    { "type": "text", "id": "event_date", "label": "t:labels.event_date", "default": "05 SEP '26" },
    { "type": "textarea", "id": "event_location", "label": "t:labels.event_location", "default": "Algarve\nVilamoura" },
    { "type": "url", "id": "event_link", "label": "t:labels.event_link" }
  ],
  "presets": [{ "name": "t:sections.elysian_hero.name" }]
}
{% endschema %}
