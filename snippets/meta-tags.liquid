{% doc %}
  Renders page metadata, social previews and brand structured data.
  @example
  {% render 'meta-tags' %}
{% enddoc %}
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign og_title = page_title | default: 'Elysian Groove' | replace: 'A minha loja', 'Elysian Groove'
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign seo_content = shop.description
  case request.page_type
    when 'product'
      assign seo_content = product.description
    when 'collection'
      assign seo_content = collection.description
    when 'page'
      assign seo_content = page.content
    when 'article'
      assign seo_content = article.excerpt_or_content
  endcase
  assign seo_fallback = 'Elysian Groove creates electronic music experiences in Lisbon. Explore our events, story and clothing collection.'
  assign og_description = page_description | default: seo_content | strip_html | strip_newlines | strip | default: seo_fallback | truncate: 160
  assign brand_logo = 'logo.png' | asset_url
  assign share_image = 'pop_up_nov24.PNG' | asset_url
  unless brand_logo contains '://'
    assign logo_prefix = brand_logo | slice: 0, 2
    if logo_prefix == '//'
      assign brand_logo = brand_logo | prepend: 'https:'
    else
      assign brand_logo = brand_logo | prepend: request.origin
    endif
  endunless
  unless share_image contains '://'
    assign image_prefix = share_image | slice: 0, 2
    if image_prefix == '//'
      assign share_image = share_image | prepend: 'https:'
    else
      assign share_image = share_image | prepend: request.origin
    endif
  endunless

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ 'Elysian Groove' }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="{{ page_image | image_url: width: 1200 | prepend: 'https:' }}"
  >
  <meta
    property="og:image:secure_url"
    content="{{ page_image | image_url: width: 1200 | prepend: 'https:' }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
  <meta name="twitter:image" content="{{ page_image | image_url: width: 1200 | prepend: 'https:' }}">
{%- else -%}
  <meta property="og:image" content="{{ share_image | escape }}">
  <meta name="twitter:image" content="{{ share_image | escape }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ page_title | replace: 'A minha loja', 'Elysian Groove' }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless page_title contains 'Elysian Groove' %} &ndash; {{ 'Elysian Groove' }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

  <meta
    name="description"
    content="{{ og_description | escape }}"
  >

{% if request.page_type == 'index' %}
  {% assign site_url = request.origin %}
  {% assign organization_id = site_url | append: '/#organization' %}
  {% assign website_id = site_url | append: '/#website' %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": {{ organization_id | json }},
          "name": "Elysian Groove",
          "url": {{ site_url | json }},
          "logo": {{ brand_logo | json }},
          "sameAs": ["https://www.instagram.com/elysian.groove/"]
        },
        {
          "@type": "WebSite",
          "@id": {{ website_id | json }},
          "name": "Elysian Groove",
          "url": {{ site_url | json }},
          "publisher": { "@id": {{ organization_id | json }} }
        }
      ]
    }
  </script>
{% endif %}
