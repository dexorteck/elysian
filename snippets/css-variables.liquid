{% doc %}
  Outputs the global font declarations and design tokens configured by the merchant.
{% enddoc %}

{% style %}
  :root {
    --font-primary-family: Helvetica, Arial, sans-serif;
    --font-primary-style: normal;
    --font-primary-weight: {{ settings.type_primary_font.weight }};
    --font-display-family: Helvetica, Arial, sans-serif;
    --font-display-style: normal;
    --font-display-weight: {{ settings.type_display_font.weight }};
    --letter-spacing-display: -0.035em;
    --letter-spacing-label: 0.055em;
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --site-gutter: clamp(1.5rem, 4vw, 4rem);
    --site-edge: var(--site-gutter);
    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};
    --color-accent: {{ settings.accent_color }};
    --color-surface: {{ settings.surface_color }};
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
  }
{% endstyle %}
